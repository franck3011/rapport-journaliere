# Copiez ce fichier en .env (ou .env.local) et remplissez les valeurs.
# Ne mettez JAMAIS les clés secrètes dans un fichier commité.

# --- Client (navigateur) : clés publiques Supabase ---
VITE_SUPABASE_URL=https://<votre-projet>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<clé publishable/anon>
VITE_SUPABASE_PROJECT_ID=<id du projet>

# --- Serveur : mêmes valeurs publiques ---
SUPABASE_URL=https://<votre-projet>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<clé publishable/anon>
SUPABASE_PROJECT_ID=<id du projet>

# --- Serveur uniquement : SECRETS (à définir dans l'hébergeur, jamais dans Git) ---
SUPABASE_SERVICE_ROLE_KEY=<clé service_role — très sensible>
GEMINI_API_KEY=<clé API Gemini pour l'assistant IA>
LOVABLE_API_KEY=<clé Lovable AI Gateway, si utilisée>
