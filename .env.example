# ============================================================================
# DailyBrief — variables d'environnement (déploiement hors Lovable)
# Copier en `.env` (local) et renseigner dans l'hébergeur (Vercel/Cloudflare).
# ============================================================================

# --- Supabase (obligatoire) -------------------------------------------------
# URL du projet : https://<ref>.supabase.co
SUPABASE_URL=
VITE_SUPABASE_URL=
# Clé anonyme/publishable (visible côté navigateur, c'est normal)
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Clé service_role — NE JAMAIS exposer côté client
SUPABASE_SERVICE_ROLE_KEY=

# --- URL publique de l'application (obligatoire) ----------------------------
# Utilisée pour les métadonnées Open Graph, les redirections OAuth mail, etc.
APP_URL=https://votre-domaine.com
VITE_APP_URL=https://votre-domaine.com

# --- Intelligence artificielle (obligatoire) --------------------------------
# Clé gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Messagerie unifiée -----------------------------------------------------
# Clé de chiffrement des jetons OAuth mail (32 caractères minimum, aléatoire).
# ⚠️ Garder EXACTEMENT la même valeur qu'avant migration, sinon les comptes
#    e-mail déjà enregistrés deviennent illisibles.
MAIL_CRYPTO_KEY=
# Secret protégeant /api/public/mail/dispatch-scheduled (32+ caractères)
MAIL_DISPATCH_SECRET=
# Origine publique déclarée chez Google/Microsoft (doit correspondre à APP_URL)
MAIL_OAUTH_ORIGIN=

# OAuth Google (messagerie)
MAIL_GOOGLE_CLIENT_ID=
MAIL_GOOGLE_CLIENT_SECRET=
# OAuth Microsoft (messagerie)
MAIL_MICROSOFT_CLIENT_ID=
MAIL_MICROSOFT_CLIENT_SECRET=

# --- Ancien gateway mail (optionnel, si encore utilisé) ---------------------
MAIL_GATEWAY_URL=
MAIL_GATEWAY_TOKEN=

# --- Notes ----------------------------------------------------------------
# LOVABLE_API_KEY et LOVABLE_DB_MIGRATION_URL ne sont plus utilisés.
# Pensez à configurer aussi, dans Supabase :
#   - Authentication > URL Configuration : Site URL = APP_URL,
#     Redirect URLs = APP_URL/** , APP_URL/auth
#   - Storage : buckets report-images, report-attachments, ged-documents,
#     company-proofs, project-files, leave-proofs
